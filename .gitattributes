# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Source/asset verification and release receipts hash these files byte for byte.
# Preserve generated bytes (including EOLs) so a fresh checkout passes the same gates.
data/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
scripts/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
tools/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
tests/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
reports/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
