# Godot 4+ specific ignores
.godot/
/.wrangler/
/android/

# Python importer caches
__pycache__/
*.py[cod]

# Local Web exports
/build/*
!/build/.gdignore

# Generated output artifacts (kept locally)
/output/

# Validation output is reproducible. Track source manifests and active delivery summaries.
/tests/fixtures/*.json.error
/reports/*
!/reports/.gdignore
