# Godot 4+ specific ignores
.godot/
/android/

# Python importer caches
__pycache__/
*.py[cod]

# Local Web exports
/build/*
!/build/.gdignore

# Validation output is reproducible. Track source manifests and compact summaries.
/reports/*
!/reports/.gdignore
!/reports/ASSET_REPORT.md
!/reports/assets_manifest.json
!/reports/assets_verification.json
!/reports/assets_sync_summary.json
!/reports/verification_summary.json
!/reports/godot_assets_verification.json
!/reports/level01_assets.json
!/reports/level01_logic.json
!/reports/level01_web.json
!/reports/ui_revision_report.json
!/reports/battle_details_report.json
!/reports/map_kr1_assets.json
!/reports/map_kr1_logic.json
!/reports/map_kr1_web.json
!/reports/map_kr1_delivery.json

# Generated output artifacts (kept locally)
/output/

!/reports/playtest_tools_logic.json
!/reports/playtest_tools_delivery.json
!/reports/heroes_assets.json
!/reports/heroes_logic.json
!/reports/heroes_delivery.json
